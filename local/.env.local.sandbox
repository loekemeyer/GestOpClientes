# Sandbox LOCAL — copiar a .env.local (ya ignorado por .gitignore).
# ⚠ Apunta a la base LOCAL (127.0.0.1), NO a producción. No pegar secrets reales acá.

# Supabase LOCAL (lo que imprime `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon-key-que-imprime-supabase-start>
SUPABASE_SERVICE_ROLE_KEY=<service-key-que-imprime-supabase-start>

# Claude API — solo si querés probar el agente IA (no hace falta para el camino FAQ)
ANTHROPIC_API_KEY=sk-ant-...

# Meta WhatsApp — solo si vas a probar el webhook real con ngrok. Para lk_chat-test NO hace falta.
WEBHOOK_VERIFY_TOKEN=test-token-12345

# Rate limit (off en sandbox)
WA_RATE_LIMIT_ENABLED=0
WA_RATE_LIMIT_PER_HOUR=20

# Testing
TEST_PHONE=1166574113
